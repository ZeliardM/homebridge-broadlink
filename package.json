{
  "name": "homebridge-broadlink",
  "displayName": "Homebridge Broadlink",
  "version": "5.0.0",
  "private": true,
  "description": "Local fireplace controller using one Broadlink IR blaster and one IKEA DIRIGERA outlet.",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "lint": "eslint index.js platform.js lib/**/*.js homebridge-ui/**/*.js",
    "check": "node --check index.js && node --check platform.js && node --check lib/broadlinkClient.js && node --check lib/dirigeraOutletClient.js && node --check lib/fireplaceAccessory.js && node --check homebridge-ui/server.js && node --check homebridge-ui/public/app.js"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "broadlink",
    "dirigera",
    "fireplace"
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ZeliardM"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.me/ZeliardM/USD"
    }
  ],
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^22.12.0 || ^24.0.0"
  },
  "files": [
    "config.schema.json",
    "homebridge-ui",
    "index.js",
    "lib",
    "platform.js",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.3",
    "dirigera": "^1.8.0",
    "kiwicam-broadlinkjs-rm": "^0.9.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0"
  }
}
